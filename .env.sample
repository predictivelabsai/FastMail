# --- FastMail --------------------------------------------------------------
FASTMAIL_ADMIN_EMAIL=admin@fastmail.example
FASTMAIL_ADMIN_PASSWORD=FastMail2026$
FASTMAIL_SECRET=
FASTMAIL_PORT=5009
FASTMAIL_ENV_LABEL=FastMail
FASTMAIL_DB=

# --- AI (chat + summarise/draft) ------------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google. Slash-commands need no key.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mail.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://mail.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
